import J2S2

/-! `π₄(S³)` is nontrivial: `η loop3 ≠ refl` by `bit` after transport along
the 3-cube rotating `J₂S²` by its surfaces (cctt's `hope` without its
cheats). -/

/-

Human note from Tom:

This is based on [this Cubical Agda
example](https://storage.googleapis.com/pi3js2/Pi3JS2.J2S2.html#1865)
which I wrote in 2024. It does not seem feasible to compute it in
Cubical Agda today. I was never able to compute any analogous example
in cctt, but it might be possible (cctt is definitely better than
kleenextt!)

I did compute a related example in cubicaltt once, with postulates for
cheating, but:

1. some other computations in cubicaltt were _suspiciously_
   fast... this mystery remains unexplained.
2. this computation was not suspiciously fast, but I believe that
   doing it without postulates would have been both extremely verbose
   (essentially due to lack of "hlevel" tactic) and far too slow to
   typecheck (in large part due to those same "by hlevel" goals.)
   Funny how the "it's trivially trivial" parts of the proof still
   tend to be so hard. :D

-/

data S3 := base3
  | loop3 (i j k : I) [ (i = 0) ↦ base3, (i = 1) ↦ base3, (j = 0) ↦ base3, (j = 1) ↦ base3,
                        (k = 0) ↦ base3, (k = 1) ↦ base3 ]
def Ω4 : (A : Type) → A → Type := λ A x => Ω (Ω3 A x) refl
def Z2 : Type → Type := λ A => Ω2 (A → A) (λ x => x)

data J2S2t := tjbase
  | tjsurf (i j : I) [ (i = 0) ↦ tjbase, (i = 1) ↦ tjbase, (j = 0) ↦ tjbase, (j = 1) ↦ tjbase ]
  | tjsurfsurf (i j a b : I) [ (i = 0) ↦ tjsurf a b, (i = 1) ↦ tjsurf a b, (j = 0) ↦ tjsurf a b, (j = 1) ↦ tjsurf a b,
                               (a = 0) ↦ tjsurf i j, (a = 1) ↦ tjsurf i j, (b = 0) ↦ tjsurf i j, (b = 1) ↦ tjsurf i j ]
  | jtrunc (x y : J2S2t) (p q : Path J2S2t x y) (r s : Path (Path J2S2t x y) p q)
      (t u : Path (Path (Path J2S2t x y) p q) r s) (v w : Path (Path (Path (Path J2S2t x y) p q) r s) t u)
      (a b c d e : I)
      [ (a = 0) ↦ v b c d e, (a = 1) ↦ w b c d e, (b = 0) ↦ t c d e, (b = 1) ↦ u c d e,
        (c = 0) ↦ r d e, (c = 1) ↦ s d e, (d = 0) ↦ p e, (d = 1) ↦ q e, (e = 0) ↦ x, (e = 1) ↦ y ]
def truncJ : is3Groupoid J2S2t := λ x y p q r s t u v w => λ a b c d e => jtrunc x y p q r s t u v w a b c d e

def surfsJ : (x : J2S2t) → Ω2 J2S2t x := λ x => case x (λ x => Ω2 J2S2t x)
  [ tjbase ↦ λ k l => tjsurf k l, tjsurf i j ↦ λ k l => tjsurfsurf i j k l,
    tjsurfsurf i j a b ↦ λ k l => hlevel 5 truncJ,
    jtrunc x y p q r s t u v w a b c d e ↦ λ k l => hlevel 5 truncJ ]

-- `funP` into the 2-groupoids, so the truncation case is an `hlevel`.
def is2GroupoidPair : is2Groupoid PairT :=
  is2GroupoidSigma S1t (λ _ => S2m2) (isGroupoidTo2Groupoid S1t truncS1t) (λ _ => truncS2m2)
def funPt : J2S2t → h2Groupoid := λ x => case x (λ _ => h2Groupoid)
  [ tjbase ↦ (PairT, is2GroupoidPair),
    tjsurf i j ↦ (globalRL i j, hlevel 1 (isPropIs2Groupoid (globalRL i j))),
    tjsurfsurf i j a b ↦ (gnarly i j a b, hlevel 1 (isPropIs2Groupoid (gnarly i j a b))),
    jtrunc x y p q r s t u v w a b c d e ↦ hlevel 5 is3GroupoidH2Groupoid ]
def fun1t : Ω J2S2t tjbase → PairT := λ p => transport (λ i => fst (funPt (p i))) (tbase, sbase)
def fun2t : Ω3 J2S2t tjbase → Ω2 S2m2 sbase := λ p => λ i j => snd (fun1t (λ k => p i j k))
def bit3t : Ω3 J2S2t tjbase → Bool := λ p => bit2 (fun2t p)

#conv bit3t (eta J2S2t tjbase (λ i j => tjsurf i j)) = true

def rot2Equiv : (A : Type) (h : Z2 A) → PathP (λ i => PathP (λ j => Equiv A A) (idEquiv A) (idEquiv A)) refl refl :=
  λ A h => λ i j => (λ x => h i j x, hlevel 1 (propIsEquivDirect A A (λ x => h i j x)))
def global3 : (A : Type) (h : Z2 A) → Ω3 Type A :=
  λ A h i j k => Glue A [ (i = 0) ↦ (A, idEquiv A), (i = 1) ↦ (A, idEquiv A), (j = 0) ↦ (A, idEquiv A),
                          (j = 1) ↦ (A, idEquiv A), (k = 0) ↦ (A, rot2Equiv A h i j), (k = 1) ↦ (A, idEquiv A) ]
def codeS3 : S3 → Type := λ x => case x (λ _ => Type)
  [ base3 ↦ J2S2t, loop3 i j k ↦ global3 J2S2t (λ i j => λ x => surfsJ x i j) i j k ]
def toJ : Ω S3 base3 → J2S2t := λ p => transport (λ i => codeS3 (p i)) tjbase

def genπ4S3 : Ω4 S3 base3 := eta (Ω S3 base3) refl (λ i j k => loop3 i j k)
def π4Invariant : Ω4 S3 base3 → Bool := λ q => bit3t (λ i j k => toJ (q i j k))

def trueNeFalse : Path Bool true false → Empty := λ e => transport (λ i => codeBool true (e i)) tt
def π4S3Nontrivial : Path (Ω4 S3 base3) genπ4S3 refl → Empty := λ e => trueNeFalse (λ t => π4Invariant (e t))
