import Brunerie

/-! The rungs below `brunerie`, to find where a regression's cost is, and
`brunerieW`, the cubes as nested `hcomp`s with connections: 30 s and 1.9 GB
where `brunerie` takes under a second. -/

#ktime windingS1 (λ i => loop i)
#ktime windingS2 (λ i j => loop2 i j)
#ktime λ (i j : I) => split (λ k => w22 i j k)
#ktime writhe (λ i j k => base2)

#kconv brunerieW = pos (suc (suc zero))
